# X API (app-only OAuth 2.0 bearer token). Omit to use deterministic mock data.
X_BEARER_TOKEN=
# XBOT_X_MODE=mock

# Models in Mastra provider/model format. XBOT_MODEL fills any role not set explicitly.
# Without models, research workflows run deterministically and chat is disabled.
XBOT_MODEL=
# XBOT_MODEL_CHAT=
# XBOT_MODEL_PLANNING=
# XBOT_MODEL_ANALYSIS=
# XBOT_MODEL_REPORTING=
# Provider API keys, e.g. OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY

# Storage (libSQL). CLI default: file:~/.xbot/xbot.db
# XBOT_DB_URL=file:./xbot.db
# Production: PostgreSQL (requires the optional pg and @mastra/pg packages)
# XBOT_DB_URL=postgres://user:password@host:5432/xbot

# X spending limits in USD
# XBOT_BUDGET_RUN_USD=1
# XBOT_BUDGET_REQUEST_USD=0.5
# XBOT_BUDGET_DAILY_USD=5
# XBOT_BUDGET_MONTHLY_USD=50

# HTTP API (token:tenant pairs; tokens >= 16 chars)
# XBOT_HTTP_TOKENS=change-me-please-0001:default
# MCP remote transport
# XBOT_MCP_TOKENS=change-me-please-0002:default
# Slack
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# XBOT_SLACK_ALLOWED_USERS=U123,U456
