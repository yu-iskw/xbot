{
  "name": "@yu-iskw/xbot-mcp",
  "version": "0.1.0",
  "description": "MCP server (stdio and authenticated Streamable HTTP) exposing xbot X research tools and reports.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yu-iskw/xbot.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "xbot-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mastra/core": "^1.79.0",
    "@mastra/mcp": "^2.5.0",
    "@yu-iskw/xbot-core": "workspace:*",
    "zod": "^4.6.7"
  }
}
